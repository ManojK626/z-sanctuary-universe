{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/vile/schemas/v1/culture.json",
  "title": "VILECulturePack",
  "description": "Cultural heritage and etiquette guidance pack.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "regionId", "title", "verificationStatus", "contentBlocks"],
  "properties": {
    "id": { "type": "string", "pattern": "^culture-" },
    "regionId": { "type": "string" },
    "title": { "type": "string" },
    "locales": { "type": "array", "items": { "type": "string" } },
    "contentBlocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["heading", "body"],
        "properties": {
          "heading": { "type": "string" },
          "body": { "type": "string" },
          "stewardRef": { "type": "string" }
        }
      }
    },
    "verificationStatus": {
      "type": "string",
      "enum": ["verified", "steward_reviewed", "illustrative", "placeholder"]
    },
    "doAndDont": {
      "type": "object",
      "properties": {
        "do": { "type": "array", "items": { "type": "string" } },
        "dont": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
