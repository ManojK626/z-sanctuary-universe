{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/discovery-answer.json",
  "title": "ZConnectDiscoveryAnswer",
  "description": "User answer — explicitly provided.",
