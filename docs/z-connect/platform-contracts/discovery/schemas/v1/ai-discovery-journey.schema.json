{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/discovery-journey.json",
  "title": "ZConnectDiscoveryJourney",
  "description": "Progressive Discovery journey container.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "journeyId",
    "userId",
    "phase",
    "startedAtIso"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "journeyId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "userId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/UserId"
    },
    "phase": {
      "type": "string",
      "enum": [
        "day_1",
        "week_1",
        "month_1",
        "ongoing"
      ]
    },
    "sessionIds": {
      "type": "array",
      "items": {
        "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
      }
    },
    "startedAtIso": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/TimestampIso"
    }
  }
}
