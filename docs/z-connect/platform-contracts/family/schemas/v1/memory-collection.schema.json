{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/memory-collection.json",
  "title": "ZConnectMemoryCollection",
  "description": "Curated memory collection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "collectionId",
    "ownerUserId",
    "title"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "collectionId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "ownerUserId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/UserId"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "imageRefs": {
      "type": "array",
      "items": {
        "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/ImageReference"
      }
    }
  }
}
