{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/family-timeline.json",
  "title": "ZConnectFamilyTimeline",
  "description": "Shared family milestone timeline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "timelineId",
    "ownerUserIds",
    "title",
    "createdAtIso"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "timelineId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "ownerUserIds": {
      "type": "array",
      "items": {
        "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/UserId"
      },
      "minItems": 1
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "createdAtIso": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/TimestampIso"
    }
  }
}
