{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/user-languages.json",
  "title": "ZConnectUserLanguages",
  "description": "Languages spoken or preferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "userId",
    "spoken"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "userId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/UserId"
    },
    "spoken": {
      "type": "array",
      "items": {
        "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Locale"
      },
      "minItems": 1
    },
    "learning": {
      "type": "array",
      "items": {
        "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Locale"
      }
    }
  }
}
