{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/ai-reflection.json",
  "title": "ZConnectAiReflection",
  "description": "Reflective prompt or mirror-back — encourages human choice.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reflectionId",
    "userId",
    "prompt",
    "confidence",
    "explanation",
    "limitations",
    "disclaimer"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "reflectionId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "userId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/UserId"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "confidence": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/ConfidenceLevel"
    },
    "explanation": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/AiExplanation"
    },
    "limitations": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/AiLimitations"
    },
    "disclaimer": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/InsightDisclaimer"
    }
  }
}
