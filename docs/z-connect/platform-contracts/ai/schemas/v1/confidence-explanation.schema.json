{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/ai-confidence-explanation.json",
  "title": "ZConnectConfidenceExplanation",
  "description": "Explains confidence level for a dimension.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "explanationId",
    "dimensionId",
    "confidence",
    "because",
    "disclaimer"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "explanationId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "dimensionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "confidence": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/ConfidenceLevel"
    },
    "because": {
      "type": "string",
      "maxLength": 1000
    },
    "unknown": {
      "type": "string",
      "maxLength": 1000
    },
    "disclaimer": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/InsightDisclaimer"
    }
  }
}
