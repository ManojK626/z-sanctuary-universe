{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/ai-profile-summary.json",
  "title": "ZConnectProfileSummary",
  "description": "AI-proposed profile themes awaiting user approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "summaryId",
    "userId",
    "proposedThemes",
    "approved",
    "confidence",
    "explanation",
    "limitations",
    "disclaimer"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "summaryId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "userId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/UserId"
    },
    "proposedThemes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "approved": {
      "type": "boolean"
    },
    "confidence": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/ConfidenceLevel"
    },
    "explanation": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/AiExplanation"
    },
    "limitations": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/AiLimitations"
    },
    "disclaimer": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/InsightDisclaimer"
    }
  }
}
