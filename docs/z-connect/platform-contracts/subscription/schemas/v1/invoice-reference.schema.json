{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/invoice-reference.json",
  "title": "ZConnectInvoiceReference",
  "description": "Reference to external invoice — no payment execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "invoiceRefId",
    "membershipId",
    "externalInvoiceId",
    "issuedAtIso"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "invoiceRefId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "membershipId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "externalInvoiceId": {
      "type": "string",
      "maxLength": 128
    },
    "issuedAtIso": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/TimestampIso"
    }
  }
}
