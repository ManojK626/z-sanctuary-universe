{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/membership.json",
  "title": "ZConnectMembership",
  "description": "Membership record — payment runtime HOLD.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "membershipId",
    "userId",
    "planId",
    "status",
    "startedAtIso"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "membershipId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "userId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/UserId"
    },
    "planId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "status": {
      "type": "string",
      "enum": [
        "trialing",
        "active",
        "paused",
        "cancelled"
      ]
    },
    "startedAtIso": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/TimestampIso"
    }
  }
}
