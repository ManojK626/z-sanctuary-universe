{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/premium-feature.json",
  "title": "ZConnectPremiumFeature",
  "description": "Catalog entry for premium capability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "featureCode",
    "label"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "featureCode": {
      "type": "string",
      "maxLength": 64
    },
    "label": {
      "type": "string",
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 500
    }
  }
}
