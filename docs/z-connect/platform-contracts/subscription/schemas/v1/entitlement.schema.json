{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/entitlement.json",
  "title": "ZConnectEntitlement",
  "description": "Feature entitlement granted by plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entitlementId",
    "userId",
    "featureCode",
    "active"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "entitlementId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "userId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/UserId"
    },
    "featureCode": {
      "type": "string",
      "maxLength": 64
    },
    "active": {
      "type": "boolean"
    },
    "expiresAtIso": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/TimestampIso"
    }
  }
}
