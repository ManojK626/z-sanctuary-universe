{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/messaging-reaction.json",
  "title": "ZConnectMessageReaction",
  "description": "Emoji or typed reaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reactionId",
    "messageId",
    "userId",
    "reactionCode",
    "reactedAtIso"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "reactionId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "messageId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "userId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/UserId"
    },
    "reactionCode": {
      "type": "string",
      "maxLength": 32
    },
    "reactedAtIso": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/TimestampIso"
    }
  }
}
