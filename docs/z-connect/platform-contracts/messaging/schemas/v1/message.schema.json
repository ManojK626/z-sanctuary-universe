{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/messaging-message.json",
  "title": "ZConnectMessage",
  "description": "Single message in a conversation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messageId",
    "conversationId",
    "senderUserId",
    "body",
    "sentAtIso"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "messageId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "conversationId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "senderUserId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/UserId"
    },
    "body": {
      "type": "string",
      "maxLength": 10000
    },
    "sentAtIso": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/TimestampIso"
    },
    "editedAtIso": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/TimestampIso"
    }
  }
}
