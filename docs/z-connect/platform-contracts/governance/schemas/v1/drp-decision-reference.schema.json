{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/drp-decision-reference.json",
  "title": "ZConnectDrpDecisionReference",
  "description": "Link to hub ZDRPDecision record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "overall",
    "recordedAtIso"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "decisionId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "overall": {
      "type": "string",
      "enum": [
        "pass",
        "pending_human",
        "blocked"
      ]
    },
    "recordedAtIso": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/TimestampIso"
    }
  }
}
