{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/shadow-validation-reference.json",
  "title": "ZConnectShadowValidationReference",
  "description": "Link to Shadow pipeline result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "validationId",
    "approved",
    "status",
    "recordedAtIso"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "validationId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "approved": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "degraded"
      ]
    },
    "recordedAtIso": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/TimestampIso"
    }
  }
}
