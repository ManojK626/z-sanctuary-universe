{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/consent-withdrawal.json",
  "title": "ZConnectConsentWithdrawal",
  "description": "User withdrawal of prior consent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "withdrawalId",
    "consentId",
    "userId",
    "withdrawnAtIso"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "withdrawalId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "consentId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "userId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/UserId"
    },
    "withdrawnAtIso": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/TimestampIso"
    },
    "reason": {
      "type": "string",
      "maxLength": 500
    }
  }
}
