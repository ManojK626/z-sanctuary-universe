{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/consent-version.json",
  "title": "ZConnectConsentVersion",
  "description": "Version marker for consent text shown to user.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "versionId",
    "effectiveAtIso",
    "documentRef"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "versionId": {
      "type": "string",
      "pattern": "^v[0-9]+(\\.[0-9]+)?$"
    },
    "effectiveAtIso": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/TimestampIso"
    },
    "documentRef": {
      "type": "string",
      "description": "Path or URL to human-readable consent copy"
    }
  }
}
