{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/relationship-goal.json",
  "title": "ZConnectRelationshipGoal",
  "description": "User-stated goal for a branch — not a platform verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "userId",
    "branch",
    "goalStatement",
    "updatedAtIso"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "userId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/UserId"
    },
    "branch": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/RelationshipBranch"
    },
    "goalStatement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "updatedAtIso": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/TimestampIso"
    }
  }
}
