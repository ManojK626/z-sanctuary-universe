{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://z-sanctuary.local/z-connect/schemas/v1/connection-request.json",
  "title": "ZConnectConnectionRequest",
  "description": "Consent-based connection invitation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "fromUserId",
    "toUserId",
    "branch",
    "requestedAtIso",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/SchemaVersion"
    },
    "requestId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/Identifier"
    },
    "fromUserId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/UserId"
    },
    "toUserId": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/UserId"
    },
    "branch": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/RelationshipBranch"
    },
    "message": {
      "type": "string",
      "maxLength": 500
    },
    "requestedAtIso": {
      "$ref": "../../common/schemas/v1/_definitions.schema.json#/$defs/TimestampIso"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "withdrawn"
      ]
    }
  }
}
